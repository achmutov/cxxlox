Checks: >
  performance-*,
  modernize-*,
  misc-*,
  clang-analyzer-*,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  -misc-no-recursion,
  -misc-multiple-inheritance
CheckOptions:
  modernize-use-trailing-return-type.TransformLambdas: none
  misc-include-cleaner.IgnoreHeaders: '.*\.cppm'
